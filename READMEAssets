/* Color Palette Mapping for Euro Drive TCU Dashboard */
.status-critical { color: #FF3B30; filter: drop-shadow(0 0 4px #FF3B30); } /* Red warnings */
.status-action   { color: #FFCC00; filter: drop-shadow(0 0 4px #FFCC00); } /* Yellow / Amber engine faults */
.status-ok       { color: #34C759; }                                       /* Green ECO / Low beams */
.status-system   { color: #007AFF; }                                       /* Blue High Beams */
.status-dimmed   { color: #424244; opacity: 0.3; }                         /* Inactive background states */
